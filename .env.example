# Copy to .env and fill in. Never commit .env.
# Descriptive User-Agent with a contact address (polite access to public servers)
TCMON_USER_AGENT="TC-Analog-Monitor/0.1 (Universidad Distrital, Team 4; contact: your.email@example.com)"

# Docker Compose / Airflow (Workshop 2)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Application database (planned)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tcmon
POSTGRES_USER=tcmon
POSTGRES_PASSWORD=change-me

# Paths
TCMON_RAW_DIR=data/raw
TCMON_SOURCES_FILE=config/sources.yaml

# Dashboard
DASH_HOST=0.0.0.0
DASH_PORT=8050
